# Copy to .env (which is gitignored) and adjust. Never commit real secrets.

# --- App ---
ENV=development                # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database (docker compose reads the POSTGRES_* values too) ---
POSTGRES_USER=circuit
POSTGRES_PASSWORD=circuit
POSTGRES_DB=circuit
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://circuit:circuit@localhost:5432/circuit
TEST_DATABASE_URL=postgresql+psycopg://circuit:circuit@localhost:5432/circuit_test

# --- City for seed data and the map's default view ---
CITY_NAME=Bengaluru
CITY_CENTER_LAT=12.9716
CITY_CENTER_LNG=77.5946

# --- Auth ---
# Real logins (Clerk or Supabase): the provider's JWKS URL, plus issuer/audience if it sets them.
JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
# Demo logins for seeded personas (persona switcher). Refused in production unless DEMO_PUBLIC=true.
DEMO_AUTH=true
# Only for a demo deployment that holds fake data exclusively:
DEMO_PUBLIC=false
# Required (32+ random characters) when DEMO_AUTH is on in production, e.g. `openssl rand -hex 32`.
DEMO_JWT_SECRET=

# --- LLM onboarding (optional; the app falls back to manual pickers without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Matching (Phase 4) ---
# fastembed runs BAAI/bge-small-en-v1.5 locally (downloads ~130 MB once); "fake" is for offline/tests.
EMBEDDING_PROVIDER=fastembed
# score = w1*complementarity + w2*affinity + w3*trust_path + w4*timing - w5*load_penalty
MATCH_W_COMPLEMENTARITY=0.50
MATCH_W_AFFINITY=0.20
MATCH_W_TRUST_PATH=0.15
MATCH_W_TIMING=0.10
MATCH_W_LOAD_PENALTY=0.15
STUDENT_RADIUS_KM=10
# Background job: embed new texts and recompute all matches every N hours.
SCHEDULER_ENABLED=true
MATCH_REFRESH_HOURS=6

# Warm intros (F5): requests one member may send per week, and days before an
# unanswered request expires. Weekly capacity to receive is per member (open_intro_slots).
INTRO_REQUESTS_PER_WEEK=5
INTRO_EXPIRY_DAYS=14
